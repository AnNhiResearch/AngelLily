{
  "name": "@angellily/app",
  "version": "0.0.3",
  "description": "A featherweight autonomous Telegram agent (Angel Lily)",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "angellily": "dist/main.js"
  },
  "files": [
    "dist/",
    ".angellily/AGENTS.md",
    "LICENSE",
    "README.md",
    "README_vi.md",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc && esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --packages=external --minify --tree-shaking=true --outfile=dist/main.js && esbuild src/plugin_runner.ts --bundle --platform=node --format=esm --target=node22 --packages=external --minify --tree-shaking=true --outfile=dist/plugin_runner.js",
    "build-full": "npm install && npm run build && npm --prefix packages/ai-gateway install && npm --prefix packages/ai-gateway run build && npm --prefix packages/telegram-mini-apps install && npm --prefix packages/telegram-mini-apps run build && npm --prefix packages/tunnel install && npm --prefix packages/tunnel run build",
    "start": "node --env-file=.env dist/main.js",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "keywords": [
    "telegram",
    "bot",
    "agent",
    "ai",
    "llm"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnNhiResearch/AngelLily.git"
  },
  "bugs": {
    "url": "https://github.com/AnNhiResearch/AngelLily/issues"
  },
  "homepage": "https://github.com/AnNhiResearch/AngelLily",
  "dependencies": {
    "openai": "^4.68.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": "24.x"
  }
}
