# AngelLily requires Node.js 24 LTS.
# Do NOT use Node 26+ yet: Undici 8 changes the global fetch dispatcher
# and causes delayed / out-of-order Telegram replies.
# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# OpenAI Compatible API Configuration
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Bot Configuration
MAX_HISTORY=10

# UI language for bot messages (help, approvals, errors): en or vi (default vi)
BOT_LANGUAGE=en

# Transport Configuration: 'polling' or 'webhook'
# If TELEGRAM_WEBHOOK_URL is set, defaults to 'webhook'. Otherwise 'polling'.
TELEGRAM_TRANSPORT=polling
TELEGRAM_WEBHOOK_URL=https://example.com/telegram
TELEGRAM_WEBHOOK_PORT=3000
# TELEGRAM_WEBHOOK_SECRET=your_secret_token_here

# Plugin isolation: set to 1 to force every plugin into its own worker thread
# FORCE_WORKER=1

# Telegram Mini Apps (Canvas)
# Public HTTPS base for Mini Apps (e.g. tunnel URL). If empty, falls back to
# the origin of TELEGRAM_WEBHOOK_URL + /miniapp. If neither is set, apps are
# sent as .html files instead of web_app buttons.
# MINIAPP_PUBLIC_URL=https://example.com
#
# Plan B — standalone server (any transport, polling-friendly, Termux/NAT):
# 1) Set MINIAPP_PORT=3001 and restart the bot.
# 2) Expose it with a tunnel, then set MINIAPP_PUBLIC_URL to the tunnel URL:
#    cloudflared:  cloudflared tunnel --url http://localhost:3001
#    tailscale:    tailscale funnel 3001
#    ngrok:        ngrok http 3001
# 3) Health check: GET <tunnel>/miniapp/health -> {"ok":true,"apps":N}
# Webhook mode needs nothing (GET /miniapp/* is served on the webhook port).
# MINIAPP_PORT=3001

# SSH tunnel (optional plugin @angellily/plugin-tunnel, OFF by default).
# Zero-config public URL for Mini Apps — and for the webhook too when
# TELEGRAM_TRANSPORT=webhook. No account, no DNS. The plugin spawns ssh,
# captures the assigned domain and fills the empty URL vars below.
# Only empty values are filled — explicit config always wins.
#   off            disabled (default)
#   localhost.run  reliable, recommended for beginners
#   serveo         simple alternative (uptime varies)
# TUNNEL_PROVIDER=off
# Optional stable subdomain (first-come-first-served, provider permitting):
# TUNNEL_SUBDOMAIN=mylily
# Wait for first URL in webhook mode before the bot registers setWebhook:
# TUNNEL_TIMEOUT_MS=45000
